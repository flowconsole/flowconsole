<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <InternalsVisibleTo Include="FlowConsole.Scanners.CSharp" />
    <InternalsVisibleTo Include="FlowConsole.Scanners.CSharp.Tests" />
    <InternalsVisibleTo Include="FlowConsole.Scanners.CodeParsing.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="TreeSitter.DotNet" Version="1.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FlowConsole.Scanners.Core\FlowConsole.Scanners.Core.csproj" />
  </ItemGroup>

  <!--
    On musl-based Linux (Alpine), the pre-built TreeSitter.DotNet binaries use glibc and cannot load.
    We ship musl-compiled native libs in native/linux-musl-arm64/ for this environment.
    They are copied to the output directory so the runtime can find them.
  -->
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
    <None Include="$(MSBuildThisFileDirectory)..\..\native\linux-musl-arm64\*.so"
          Condition="Exists('$(MSBuildThisFileDirectory)..\..\native\linux-musl-arm64')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </None>
  </ItemGroup>

</Project>
