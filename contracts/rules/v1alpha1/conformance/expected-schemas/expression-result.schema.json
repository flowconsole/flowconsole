{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flowconsole.io/contracts/rules/v1alpha1/conformance/expression-result.schema.json",
  "title": "Conformance: Expression Evaluation Result",
  "description": "Expected output for expression conformance cases.",
  "oneOf": [
    {
      "type": "object",
      "required": ["ok", "value"],
      "additionalProperties": false,
      "properties": {
        "ok": { "const": true },
        "value": {}
      }
    },
    {
      "type": "object",
      "required": ["ok", "code"],
      "additionalProperties": false,
      "properties": {
        "ok": { "const": false },
        "code": {
          "type": "string",
          "pattern": "^RE_"
        }
      }
    }
  ]
}
