{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flowconsole.tech/contracts/rules/v1alpha1/conformance/normalized-result.schema.json",
  "title": "Conformance: FlowConsole RuleFile Result",
  "description": "Expected output for valid ingest conformance cases. Contains the normalized RuleFile directly.",
  "type": "object",
  "required": ["apiVersion", "kind", "rules"],
  "properties": {
    "apiVersion": { "type": "string" },
    "kind": { "const": "RuleFile" },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "kind", "target", "severity", "blocking", "assert", "message"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "kind": { "enum": ["element", "flow"] },
          "target": { "enum": ["model", "actual", "diff"] },
          "severity": { "enum": ["info", "warning", "error", "critical"] },
          "blocking": { "type": "boolean" },
          "enabled": { "type": "boolean" },
          "description": { "type": "string" },
          "tags": { "type": "array", "items": { "type": "string" } },
          "sourceFamilies": { "type": "array", "items": { "type": "string" } },
          "mode": { "type": "string" },
          "subject": { "type": "object" },
          "from": { "type": "object" },
          "to": { "type": "object" },
          "via": { "type": "object" },
          "viaMode": { "enum": ["include", "exclude"] },
          "maxDepth": { "type": "integer" },
          "allowCycles": { "type": "boolean" },
          "changeKinds": { "type": "array", "items": { "type": "string" } },
          "where": { "type": "object" },
          "let": { "type": "object" },
          "assert": { "type": "object", "required": ["source"], "properties": { "source": { "type": "string" } } },
          "message": { "type": "string" }
        }
      }
    }
  }
}
