{
  "apiVersion": "rules.flowconsole.tech/v1alpha1",
  "kind": "RuleFile",
  "rules": [
    {
      "id": "services-must-exist",
      "name": "Services must exist",
      "kind": "element",
      "target": "actual",
      "severity": "warning",
      "blocking": false,
      "enabled": true,
      "subject": {
        "entity": "elements",
        "kinds": ["Service", "Application"]
      },
      "mode": "aggregate",
      "assert": {
        "source": "count(items) > 0"
      },
      "message": "No services found"
    }
  ]
}
