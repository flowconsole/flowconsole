{
  "name": "flowconsole",
  "private": true,
  "description": "FlowConsole — Architecture as Code platform",
  "license": "Apache-2.0",
  "author": "FlowConsole <v@flowconsole.tech> (https://flowconsole.tech)",
  "repository": {
    "type": "git",
    "url": "https://github.com/flowconsole/flowconsole.git"
  },
  "homepage": "https://flowconsole.tech",
  "bugs": {
    "url": "https://github.com/flowconsole/flowconsole/issues"
  },
  "scripts": {
    "build": "pnpm run build:workspace",
    "build:workspace": "pnpm -r --filter '!flowconsole-docs' build",
    "build:web": "pnpm --filter @flowconsole/web build",
    "build:core": "pnpm --filter @flowconsole/core build",
    "build:docs": "pnpm --filter flowconsole-docs build",
    "build:sdk": "pnpm --filter @flowconsole/sdk build",
    "build:viewer": "pnpm --filter @flowconsole/viewer build && rm -rf engine/src/FlowConsole.Cli/Resources/web/* && cp -R packages/viewer/dist/. engine/src/FlowConsole.Cli/Resources/web/",
    "test": "pnpm run test:unit",
    "test:unit": "pnpm -r test:unit",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm -r build && pnpm -r publish --no-git-checks",
    "validate:rules": "node contracts/rules/v1alpha1/validate.mjs",
    "validate:rules:conformance": "node contracts/rules/v1alpha1/validate.mjs contracts/rules/v1alpha1/conformance/ingest/valid/*.yaml && node contracts/rules/v1alpha1/validate.mjs contracts/rules/v1alpha1/conformance/ingest/invalid/*.yaml --expect-errors",
    "validate:rules:expected": "node contracts/rules/v1alpha1/validate.mjs --check-expected",
    "validate:rules:all": "pnpm validate:rules:conformance && pnpm validate:rules:expected",
    "validate:snapshots:valid": "node contracts/model-snapshot/v1/validate.mjs contracts/model-snapshot/v1/conformance/valid/*.json",
    "validate:snapshots:invalid": "node contracts/model-snapshot/v1/validate.mjs contracts/model-snapshot/v1/conformance/invalid/*.json --expect-errors",
    "validate:snapshots:per-kind-valid": "node contracts/model-snapshot/v1/validate.mjs contracts/model-snapshot/v1/conformance/per-kind/*/valid.json",
    "validate:snapshots:per-kind-invalid": "node contracts/model-snapshot/v1/validate.mjs contracts/model-snapshot/v1/conformance/per-kind/*/invalid.json --expect-errors",
    "validate:snapshots:expected": "node contracts/model-snapshot/v1/validate.mjs --check-expected",
    "validate:snapshots:all": "pnpm validate:snapshots:valid && pnpm validate:snapshots:invalid && pnpm validate:snapshots:per-kind-valid && pnpm validate:snapshots:per-kind-invalid && pnpm validate:snapshots:expected"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "ajv": "^8.17.1",
    "@eslint/js": "^9.39.1",
    "@monaco-editor/react": "^4.7.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@vitejs/plugin-react": "^5.1.2",
    "@xyflow/react": "^12.10.0",
    "d3-shape": "^3.2.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "graphviz-wasm": "^3.0.2",
    "js-yaml": "^4.1.0",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "typescript-eslint": "^8.49.0",
    "vitest": "^4.0.15"
  },
  "packageManager": "pnpm@10.19.0"
}
